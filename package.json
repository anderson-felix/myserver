{
  "name": "myserver-orchestrator",
  "productName": "MyServer Orchestrator",
  "version": "0.1.1",
  "description": "Transforma qualquer PC/Notebook em um servidor Web e de APIs seguro, resiliente e de baixo consumo (Local-First & Zero-Cost).",
  "main": "./out/main/index.js",
  "author": "DarkLabs",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "decrypt-backup": "node scripts/decrypt-backup.mjs",
    "dist": "npm run build && electron-builder --win --config electron-builder.json",
    "dist:dir": "npm run build && electron-builder --win --dir --config electron-builder.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "auto-launch": "^5.0.6",
    "better-sqlite3": "^13.0.3",
    "node-cron": "^4.6.0",
    "qrcode": "^1.5.4",
    "simple-git": "^4.0.2",
    "ssh2": "^1.17.0",
    "systeminformation": "^5.33.16",
    "tar": "^7.5.22",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/auto-launch": "^5.0.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/tar": "^6.1.13",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "execa": "^10.2.0",
    "get-port": "^7.2.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}